    DOCUMENTS ||--o{ WRITING_SUBMISSIONS : context_for

    VOCAB_ITEMS ||--|| VOCAB_REVIEWS : has_sm2_state
    VOCAB_ITEMS ||--o{ CONTEXTUAL_GUESS_ATTEMPTS : guessed_in

    READING_SESSIONS ||--o{ READING_ANSWERS : contains
    DOCUMENT_CHUNKS ||--o{ READING_ANSWERS : cited_by

    PODCASTS ||--o{ TRANSCRIPT_SEGMENTS : has_words
    PODCASTS ||--o{ DICTATION_ATTEMPTS : practiced_from

