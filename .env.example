# File này CHỈ dùng cho docker-compose.yml (biến ${POSTGRES_USER}...).
# Docker Compose tự động đọc file ".env" ở CÙNG CẤP với docker-compose.yml —
# khác với backend/.env (đó là cấu hình riêng của app FastAPI).
# Copy file này thành ".env" (bỏ đuôi .example) rồi điền giá trị thật.

POSTGRES_USER=lumina_user
POSTGRES_PASSWORD=changeme_use_a_strong_password
POSTGRES_DB=lumina_db