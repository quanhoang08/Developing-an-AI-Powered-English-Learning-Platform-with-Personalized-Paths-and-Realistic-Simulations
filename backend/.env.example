# Cấu hình app FastAPI — khớp 1-1 với các field trong app/core/config.py
# Copy file này thành ".env" rồi điền giá trị thật.

# ----- App -----
APP_NAME=Lumina English Platform
ENV=development
DEBUG=true

# ----- Database -----
# Dùng khi chạy app trực tiếp trên máy (không qua docker-compose).
# Khi chạy qua docker-compose, 2 biến này bị override trong docker-compose.yml
# (trỏ tới hostname "db" thay vì localhost).
DATABASE_URL=postgresql+asyncpg://lumina_user:lumina_dev_password_change_me@localhost:5432/lumina_db
DATABASE_URL_SYNC=postgresql+psycopg2://lumina_user:lumina_dev_password_change_me@localhost:5432/lumina_db

# ----- Auth -----
# Sinh secret thật bằng: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=REPLACE_WITH_YOUR_OWN_RANDOM_SECRET_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ----- Gemini (LLM) -----
# Lấy API key tại: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=REPLACE_WITH_YOUR_GOOGLE_API_KEY
GEMINI_MODEL_NAME=gemini-2.0-flash
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_OUTPUT_TOKENS=4096
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# ----- Azure Speech -----
# Lấy key/region tại Azure Portal > Speech service > Keys and Endpoint
AZURE_SPEECH_KEY=REPLACE_WITH_YOUR_AZURE_SPEECH_KEY
AZURE_SPEECH_REGION=southeastasia
AZURE_SPEECH_DEFAULT_VOICE=en-US-AvaMultilingualNeural
AZURE_SPEECH_DEFAULT_LOCALE=en-US

# ----- Storage -----
STORAGE_ROOT=storage
STORAGE_DOCUMENTS_DIR=storage/documents
STORAGE_AUDIO_DIR=storage/audio
MAX_UPLOAD_SIZE_MB=20

# ----- CORS -----
# Pydantic-settings tự parse chuỗi JSON list dạng này thành list[str]
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]