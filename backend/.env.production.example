# Render đọc biến từ render.yaml + dashboard; file này chỉ liệt kê để bạn biết cần những gì (KHÔNG commit giá trị thật).
ENV=production
JWT_SECRET_KEY=          # Render tự sinh (generateValue)
DATABASE_URL=            # Render tự điền từ database lumina-db
CORS_ORIGINS=["https://<ten-app>.vercel.app"]
REQUIRE_EMAIL_VERIFICATION=true
AUTH_RATE_LIMIT_PER_MINUTE=20
LLM_PROVIDER=gemini      # Render không có Ollama/GPU
EMBEDDING_PROVIDER=gemini
GOOGLE_API_KEY=
AZURE_SPEECH_KEY=        # bắt buộc cho Speaking/Listening; copy từ backend/.env
AZURE_SPEECH_REGION=     # đúng region của key (backend/.env đang dùng japaneast)
ELEVENLABS_API_KEY=      # tuỳ chọn: TTS podcast từ .docx
BREVO_API_KEY=           # Brevo > SMTP & API > API keys
MAIL_FROM_EMAIL=         # sender đã xác minh trong Brevo
MAIL_FROM_NAME=Lumina
