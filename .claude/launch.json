{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend-reference",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend-reference", "run", "dev"],
      "port": 3000
    },
    {
      "name": "backend",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-c",
        "import os,sys;os.chdir('backend');sys.path.insert(0,'.');import asyncio,selectors,uvicorn;server=uvicorn.Server(uvicorn.Config('app.main:app',port=8000));asyncio.run(server.serve(),loop_factory=lambda:asyncio.SelectorEventLoop(selectors.SelectSelector()))"
      ],
      "port": 8000
    }
  ]
}
