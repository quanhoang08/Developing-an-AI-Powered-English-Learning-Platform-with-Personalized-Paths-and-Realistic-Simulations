    USERS {
        uuid id PK
        string email
        string target_level
    }
    NOTEBOOK_FOLDERS {
        uuid id PK
        uuid user_id FK
        string name
    }
    DOCUMENTS {
        uuid id PK
        uuid user_id FK
        uuid folder_id FK
        string_array tags
        boolean starred
    }
    DOCUMENT_CHUNKS {
        uuid id PK
        uuid document_id FK
        vector embedding
    }
    VOCAB_ITEMS {
        uuid id PK
        uuid user_id FK
        string_array synonyms
        string_array antonyms
    }
    VOCAB_REVIEWS {
        uuid id PK
        uuid vocab_item_id FK
        numeric ease_factor
        timestamp next_review_at
    }
    READING_ANSWERS {
        uuid id PK
        jsonb options
        int correct_option_index
        int selected_option_index
    }
    READING_SESSIONS {
        uuid id PK
        uuid document_id FK "nullable, classic mode"
        uuid generated_passage_id FK "nullable, skim & scan"
        string mode
    }
    GENERATED_PASSAGES {
        uuid id PK
        uuid user_id FK
        string topic
        string level
    }
    CONTEXTUAL_GUESS_ATTEMPTS {
        uuid id PK
        uuid vocab_item_id FK "nullable"
        string term
        text challenge_sentence
        jsonb options
    }
    PODCASTS {
        uuid id PK
        uuid document_id FK
    }
    WRITING_SUBMISSIONS {
        uuid id PK
        string cefr_level
        string ielts_band
    }
    WRITING_INSIGHTS {
        uuid id PK
        uuid writing_submission_id FK
        string insight_type
    }
    PERSONAS {
        uuid id PK
        string provider
        string voice_id
    }
    ACCENTS {
        uuid id PK
        uuid persona_id FK
    }
    SCENARIOS {
        uuid id PK
    }
    CONVERSATION_SESSIONS {
        uuid id PK
        uuid scenario_id FK
        uuid persona_id FK
    }
    CONVERSATION_TURNS {
        uuid id PK
        text cefr_tip
        text grammar_tip
        numeric intent_score "nullable, chưa xác nhận"
    }
    REALTIME_CONVERSATION_METRICS {
        uuid id PK
        int avg_latency_ms
    }
    VIDEO_SOURCES {
        uuid id PK
    }
    VIDEO_SUBTITLE_INDEX {
        uuid id PK
        uuid video_source_id FK
    }
    MOVIE_CONTEXT_TTS_FALLBACK {
        uuid id PK
        text phrase_text
        uuid persona_id FK
        text audio_url
    }
    MOVIE_CONTEXT_MATCHES {
        uuid id PK
        uuid user_id FK
        string source_type
        boolean is_saved
    }
    ERROR_LOG {
        uuid id PK
        uuid user_id FK
        smallint spaced_repetition_level
    }
    SKILL_PROGRESS {
        uuid id PK
        uuid user_id FK
        string skill_name
        string cefr_level
    }
    REVIEW_PRIORITY_QUEUE {
        uuid id PK
        uuid user_id FK
        numeric priority_score
    }
    QUIZZES {
        uuid id PK
    }
    STREAKS {
        uuid user_id PK
        int current_streak
    }
